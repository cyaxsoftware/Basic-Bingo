{
  // Renderer windows (React). No Node types here: renderers are sandboxed and
  // may only reach the main process through the preload bridge (window.bingo).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
